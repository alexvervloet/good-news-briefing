# Secrets / local settings. Glob, not a literal: a stray .env.bak or
# .env.local holds the same app password the real one does.
.env*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Local data / generated briefings
*.sqlite3
good-news/

# Editor local history (may contain secrets)
.history/
.vscode/
